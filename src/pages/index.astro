---
/**
 * 占位首页（Phase 0 → Phase 1 的过渡）。
 *
 * 旧网站已在 Phase 0 删除。新的页面框架（字体、导航、主题）还没做，
 * 这里只放一个最简单的页面，让 `npm run build` 能正常产出站点。
 * Phase 1 会用新的页面框架替换本文件，Phase 4 再换成 3D MRI 首页。
 * 见 docs/design/01-implementation-plan.md。
 */
import { site } from "../lib/site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{site.name}</title>
  </head>
  <body>
    <main>
      <h1>{site.name} · {site.nameZh}</h1>
      <p>This site is being rebuilt. 网站正在重建。</p>
    </main>
  </body>
</html>
