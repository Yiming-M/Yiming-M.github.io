---
/**
 * 404 页面。GitHub Pages 对所有不存在的地址都返回这个页面（不区分语言），
 * 所以中英文写在同一页里，没有另一种语言的版本（hasAlternate={false}）。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { localePath } from "../lib/site";
---

<BaseLayout locale="en" path="/404/" title="Page not found" description="This page does not exist." hasAlternate={false} noindex>
  <article class="not-found">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p>The page you are looking for does not exist. <a href={localePath("en", "/")}>Back to the home page</a>.</p>
    <h2 lang="zh-CN">页面不存在</h2>
    <p lang="zh-CN">你要找的页面不存在。<a href={localePath("zh", "/")}>返回中文首页</a>。</p>
  </article>
</BaseLayout>

<style>
  .not-found {
    max-width: var(--measure);
    margin: 0 auto;
    padding: var(--space-16) var(--gutter) 0;
  }

  .code {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  h1 {
    margin: var(--space-2) 0 var(--space-4);
    font-size: var(--text-3xl);
  }

  h2 {
    margin: var(--space-12) 0 var(--space-4);
    font-size: var(--text-2xl);
  }

  p:lang(zh-CN) {
    line-height: var(--leading-zh);
  }
</style>
