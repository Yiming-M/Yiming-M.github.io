---
/**
 * About Me：英文 /about/，中文 /zh/about/（设计文档 §5）。
 *
 * 内容：头像、姓名、职位与单位、研究简介（两段）、研究兴趣、经历与教育、联系方式与外部链接、CV 下载。
 *
 * 文案来源（2026-11-18）：经历、学位、导师、审稿来自作者的 CV（public/cv/）；论文的 venue 和数字来自
 * src/content/publications/ 里核对过的论文数据（TACIT 的 PI-CAI 数字见论文第 4 节的 PI-CAI 实验）。
 * 改文案时，所有事实都要能在这两处找到出处（AGENTS.md 规则 5）。
 *
 * 简介里的论文名写成 [[论文 slug|显示文字]]，渲染时换成指向该论文详情页的链接（当前语言）。
 *
 * 头像：public/images/profile.jpg（作者提供的照片，裁成 800×800 的正方形）。
 * CV：public/cv/Yiming-Ma-CV-en.pdf 和 -zh.pdf，由作者提供，覆盖同名文件即可更新。
 *     页面按当前语言链接对应的 PDF，并在构建时读取文件大小；文件缺失时构建会报错，避免出现失效链接。
 */
import fs from "node:fs";
import path from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { localeStaticPaths, sections } from "../../../lib/routes";
import { localePath, localize, site, type LocalizedText } from "../../../lib/site";

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props;
const isZh = locale === "zh";
const section = sections.find((item) => item.key === "about")!;

/** 页面文案（中英文）。中文是原文（作者 2026-11-18 润色），英文对应翻译。 */
const copy = {
  /** 职位：职位名加粗占一行，单位固定分成两行（宽屏时头像的大小按这几行的总高度算，见样式里 .masthead 的说明）。 */
  position: {
    role: "Research Associate",
    org: [
      { en: "School of Biomedical Engineering & Imaging Sciences", zh: "伦敦国王学院" },
      { en: "King's College London", zh: "生物医学工程与影像科学学院" },
    ],
  },
  intro: [
    {
      zh: "我目前在伦敦国王学院（KCL）从事前列腺癌主动监测与医学人工智能研究，将纵向的前列腺 MRI 与临床病理指标、人口学信息及影像报告相结合，构建患者层面的多模态表征，用于预测疾病进展。核心挑战在于应对随访不完整、模态缺失以及多中心数据差异。近期工作 [[tacit|TACIT]]（ECCVW 2026）提出一种由验证器筛选的数据增强方法：只有当冻结的验证器确认生成样本保持任务标签不变、且确实到达目标域时，才将其加入训练；该方法把 PI-CAI 数据集上临床显著性前列腺癌（csPCa）检测的准确率从 69.71% 提升至 75.14%。",
      en: "At King's College London (KCL), I work on prostate cancer active surveillance and medical AI. I combine longitudinal prostate MRI with clinicopathological variables, demographic information and radiology reports to build patient-level multimodal representations that predict disease progression. The core challenges are incomplete follow-up, missing modalities and differences between centres. My recent work, [[tacit|TACIT]] (ECCVW 2026), proposes a validator-filtered augmentation method: a synthetic sample is added to training only when frozen validators confirm that it keeps the task label and reaches the target domain. It improves the accuracy of clinically significant prostate cancer (csPCa) detection on the PI-CAI dataset from 69.71% to 75.14%.",
    },
    {
      zh: "在此之前，我在华威大学获得系统数学博士学位（2021–2025），师从 Victor Sanchez 教授和 Tanaya Guha 教授。博士期间主要研究人群计数（[[fusioncount|FusionCount]]，ICIP 2022；[[clip-ebc|CLIP-EBC]]，ICME 2025；[[zip|ZIP]]，IEEE TIP 2026）以及多视角多模态的[[dms2|驾驶员监控]]（CVPRW 2023）。",
      en: "Before that, I completed my PhD in Mathematics of Systems at the University of Warwick (2021–2025), supervised by Prof. Victor Sanchez and Prof. Tanaya Guha. My doctoral research focused on crowd counting — [[fusioncount|FusionCount]] (ICIP 2022), [[clip-ebc|CLIP-EBC]] (ICME 2025) and [[zip|ZIP]] (IEEE TIP 2026) — and on multiview, multimodal [[dms2|driver monitoring]] (CVPRW 2023).",
    },
  ],
  interests: [
    { en: "Multimodal learning", zh: "多模态学习" },
    { en: "Medical imaging AI", zh: "医学影像 AI" },
    { en: "Longitudinal prediction", zh: "纵向预测" },
    { en: "Robustness to missing data", zh: "缺失数据下的鲁棒性" },
    { en: "Domain generalisation", zh: "域泛化" },
    { en: "Generative models", zh: "生成式模型" },
    { en: "Computer vision", zh: "计算机视觉" },
  ],
  /** 经历与教育：按开始时间倒序。title 是职位或学位（加粗），place 是单位。 */
  timeline: [
    {
      years: { en: "2026–Present", zh: "2026–至今" },
      title: { en: "Research Associate", zh: "Research Associate" },
      place: { en: "King's College London", zh: "伦敦国王学院（King's College London）" },
    },
    {
      years: { en: "2022–2023", zh: "2022–2023" },
      title: { en: "Research Assistant", zh: "研究助理" },
      place: { en: "University of Warwick", zh: "华威大学（University of Warwick）" },
    },
    {
      years: { en: "2021–2025", zh: "2021–2025" },
      title: { en: "PhD in Mathematics of Systems", zh: "系统数学博士" },
      place: { en: "University of Warwick", zh: "华威大学" },
    },
    {
      years: { en: "2020–2021", zh: "2020–2021" },
      title: { en: "MSc in Mathematics of Systems (Distinction)", zh: "系统数学硕士（优等）" },
      place: { en: "University of Warwick", zh: "华威大学" },
    },
    {
      years: { en: "2016–2020", zh: "2016–2020" },
      title: { en: "BSc in Mathematics and Applied Mathematics", zh: "数学与应用数学学士" },
      place: { en: "Southern University of Science and Technology", zh: "南方科技大学（SUSTech）" },
    },
  ],
  reviewing: {
    en: "Reviewer for TNNLS, TMM, SPL, ECCV, ACM MM, CVPRW, ICME, WACV, BMVC and ICIP.",
    zh: "审稿人：TNNLS、TMM、SPL、ECCV、ACM MM、CVPRW、ICME、WACV、BMVC、ICIP。",
  },
} satisfies {
  position: { role: string; org: LocalizedText[] };
  intro: LocalizedText[];
  interests: LocalizedText[];
  timeline: { years: LocalizedText; title: LocalizedText; place: LocalizedText }[];
  reviewing: LocalizedText;
};

/** 简介里的 [[slug|文字]] 换成论文详情页链接；其余文字转义后原样输出。 */
const escapeHtml = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const withPaperLinks = (text: string) =>
  escapeHtml(text).replace(/\[\[([a-z0-9-]+)\|([^\]]+)\]\]/g, (_, slug: string, label: string) => {
    const href = localePath(locale, "/publications/" + slug + "/");
    return '<a href="' + href + '">' + label + "<" + "/a>";
  });
/** 简介第一段的纯文本版本（去掉链接标记），用作页面描述。 */
const plainIntro = localize(locale, copy.intro[0]).replace(/\[\[[a-z0-9-]+\|([^\]]+)\]\]/g, "$1");

// CV：按页面语言选择文件，构建时读取大小（单位 KB）。process.cwd() 是仓库根目录。
const cvHref = `/cv/Yiming-Ma-CV-${locale}.pdf`;
const cvKb = Math.round(fs.statSync(path.join(process.cwd(), "public", cvHref)).size / 1024);

/** 联系方式：名称、显示的文字、链接地址（地址见 src/lib/site.ts）。 */
const links = [
  { label: "Email", text: site.email, href: `mailto:${site.email}` },
  { label: "Google Scholar", text: isZh ? "个人主页" : "Profile", href: site.scholar },
  { label: "GitHub", text: "Yiming-M", href: site.github },
  { label: "LinkedIn", text: site.name, href: site.linkedin },
];

/** schema.org Person：告诉搜索引擎这个网站属于谁。 */
const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: site.nameZh,
  jobTitle: "Research Associate",
  worksFor: { "@type": "Organization", name: "King's College London" },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "University of Warwick" },
    { "@type": "CollegeOrUniversity", name: "Southern University of Science and Technology" },
  ],
  email: `mailto:${site.email}`,
  url: new URL("/", Astro.site).href,
  image: new URL("/images/profile.jpg", Astro.site).href,
  sameAs: [site.scholar, site.github, site.linkedin],
};
---

<BaseLayout
  locale={locale}
  path={section.path}
  title={localize(locale, section.label)}
  description={plainIntro}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

  <article class="about" data-pagefind-body>
    <div class="content">
      <!-- 标题区：宽屏时左边是名字、职位、单位，右边的头像与这一整块同高、上下对齐；手机上头像在名字上方（见样式里 .masthead 的说明） -->
      <header class="masthead">
        <div class="identity">
          <!-- 中文页在中文名后面附英文名，小一号、浅色，不加括号：免得全角括号在窄处断到下一行 -->
          <h1>{isZh ? <><span class="zh-name">{site.nameZh}</span><span class="alt-name" lang="en">{site.name}</span></> : site.name}</h1>
          <!-- 每一行是一个块级元素；行之间加空格，读屏软件读出来不会连成一个词 -->
          <p class="position">
            <strong>{copy.position.role}</strong>{" "}
            {copy.position.org.map((line) => <span>{localize(locale, line)} </span>)}
          </p>
        </div>
        <img
          class="portrait"
          src="/images/profile.jpg"
          width="400"
          height="400"
          alt={isZh ? `${site.nameZh}的头像` : `Portrait of ${site.name}`}
          loading="eager"
          decoding="async"
        />
      </header>

      <div class="intro">
        {copy.intro.map((paragraph) => <p set:html={withPaperLinks(localize(locale, paragraph))} />)}
      </div>

      <section aria-labelledby="interests-heading">
        <h2 id="interests-heading">{isZh ? "研究兴趣" : "Research interests"}</h2>
        <ul class="interests">
          {copy.interests.map((item) => <li>{localize(locale, item)}</li>)}
        </ul>
      </section>

      <section aria-labelledby="timeline-heading">
        <h2 id="timeline-heading">{isZh ? "经历与教育" : "Experience & education"}</h2>
        <ol class="timeline" role="list">
          {
            copy.timeline.map((item) => (
              <li>
                <span class="years">{localize(locale, item.years)}</span>
                <span>
                  <strong>{localize(locale, item.title)}</strong>
                  {isZh ? "，" : ", "}
                  {localize(locale, item.place)}
                </span>
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="service-heading">
        <h2 id="service-heading">{isZh ? "学术服务" : "Professional service"}</h2>
        <p class="service">{localize(locale, copy.reviewing)}</p>
      </section>

      <section aria-labelledby="contact-heading">
        <h2 id="contact-heading">{isZh ? "联系与链接" : "Contact & links"}</h2>
        <ul class="links" role="list">
          {
            links.map((link) => (
              <li>
                <span class="link-label">{link.label}</span>
                <a href={link.href}>{link.text}</a>
              </li>
            ))
          }
        </ul>
      </section>

      <a class="cv-button" href={cvHref} download>
        {isZh ? "下载简历" : "Download CV"}
        <span class="cv-meta">PDF · {cvKb} KB</span>
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  /* 单栏：正文宽度居中。头像在标题区右侧（2026-11-18 作者要求：原来的左栏头像下面一大片空白）。 */
  .about {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 0 auto;
    padding: var(--space-12) var(--gutter) 0;
  }

  @media (min-width: 900px) {
    .about {
      padding-top: var(--space-16);
    }
  }

  .content {
    display: grid;
    gap: var(--space-12);
  }

  /* 标题区。
   * 手机（默认）：头像在上，下面是名字、职位、单位，全部左对齐。手机上放不下“与文字块同高”的头像：
   * 文字块至少四行，头像约 160px 见方，左边只剩不到 160px，单位名会被折成五六行。
   * 宽屏（≥ 768px）：左边是名字（一行）、职位（一行）、单位（两行），右边的头像边长等于这几行的总高度，
   * 上下沿与文字块对齐。高度按字号和行高算出来（--identity-h），所以这里把 h1 和职位的行高写死；
   * 单位的每一行在宽屏上都放得下，不会再折行（768px 时最长的英文那行也有余量）。 */
  .masthead {
    display: grid;
    gap: var(--space-6);
  }

  .portrait {
    order: -1;
    width: 6rem;
    height: 6rem;
    border-radius: var(--radius-surface);
    object-fit: cover;
  }

  .masthead h1 {
    line-height: 1.2;
  }

  .position {
    line-height: 1.6;
  }

  .position strong,
  .position span {
    display: block;
  }

  @media (min-width: 768px) {
    .masthead {
      --identity-h: calc(var(--text-3xl) * 1.2 + var(--space-2) + 3 * var(--text-lg) * 1.6);
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }

    .portrait {
      order: 0;
      width: var(--identity-h);
      height: var(--identity-h);
    }
  }

  /* 中文名不在字中间断行；窄屏放不下时，英文名整体换到下一行 */
  .zh-name {
    white-space: nowrap;
  }

  .alt-name {
    display: inline-block;
    margin-left: 0.4em;
    color: var(--text-secondary);
    font-size: 0.55em;
    font-weight: 400;
    white-space: nowrap;
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .position {
    margin-top: var(--space-2);
    color: var(--text-secondary);
    font-size: var(--text-lg);
  }

  .intro {
    display: grid;
    gap: var(--space-4);
  }

  h2 {
    font-size: var(--text-xl);
  }

  .interests {
    margin-top: var(--space-3);
    padding-left: 1.25em;
  }

  .interests li + li {
    margin-top: var(--space-1);
  }

  /* 经历与教育：左边是年份，右边是职位或学位；窄屏换成上下排列。 */
  .timeline {
    margin-top: var(--space-3);
  }

  .timeline li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .years {
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .service {
    margin-top: var(--space-3);
  }

  /* 职位行和时间线里加粗的职位、学位：用中等字重，和正文的文楷协调 */
  .position strong,
  .timeline strong {
    color: var(--text-primary);
    font-weight: 500;
  }

  @media (max-width: 479.98px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  /* 联系方式：左边是名称，右边是可点击的地址；窄屏换成上下排列。 */
  .links {
    margin-top: var(--space-3);
  }

  .links li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-4);
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-subtle);
  }

  .link-label {
    color: var(--text-secondary);
  }

  .links a {
    overflow-wrap: anywhere;
  }

  @media (max-width: 479.98px) {
    .links li {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  /* CV 下载：页面上唯一的实心主按钮。 */
  .cv-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: start;
    min-height: 2.75rem;
    padding: 0 var(--space-6);
    border-radius: var(--radius-pill);
    background: var(--text-primary);
    color: var(--canvas);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease);
  }

  .cv-button:hover {
    background: var(--accent);
    color: var(--canvas);
  }

  .cv-meta {
    font-size: var(--text-xs);
    opacity: 0.75;
  }
</style>
