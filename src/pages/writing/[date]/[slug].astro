---
import { getCollection, type CollectionEntry } from "astro:content";
import PostDetail from "../../../components/PostDetail.astro";
import { routeDate } from "../../../lib/site";

export async function getStaticPaths() {
  return (await getCollection("posts", ({ data }) => data.locale === "en")).map((post) => ({
    params: { date: routeDate(post.data.date), slug: post.data.route },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<"posts"> }
const { post } = Astro.props;
---
<PostDetail locale="en" post={post} />
