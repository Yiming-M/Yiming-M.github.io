---
/**
 * 页头里的搜索按钮。点击（或按 ⌘K / Ctrl+K）打开搜索对话框，对话框见 SearchDialog.astro。
 * 页头和手机菜单里各有一个本按钮，都通过 data-search-open 触发同一个对话框。
 */
import Icon from "./Icon.astro";
import type { Locale } from "../lib/site";

interface Props {
  locale: Locale;
}

const isZh = Astro.props.locale === "zh";
---

<button class="search-button" type="button" data-search-open aria-haspopup="dialog">
  <Icon name="search" size={16} />
  <span>{isZh ? "搜索" : "Search"}</span>
  <kbd aria-hidden="true">⌘K</kbd>
</button>

<style>
  .search-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--switch-border, var(--border-subtle));
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--switch-text, var(--text-secondary));
    font-size: var(--text-sm);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease),
      border-color var(--duration-fast) var(--ease);
  }

  .search-button:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  kbd {
    padding: 0 var(--space-1);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    font-size: var(--text-xs);
    line-height: 1.4;
  }
</style>
