---
/**
 * 搜索按钮（占位）。
 *
 * Phase 3 会接入 Pagefind：点击或按 ⌘K / Ctrl+K 打开搜索面板（设计文档 §7.7）。
 * 在那之前按钮保持禁用，只占住页头里的位置，方便检查布局。
 */
import Icon from "./Icon.astro";
import type { Locale } from "../lib/site";

interface Props {
  locale: Locale;
}

const isZh = Astro.props.locale === "zh";
const label = isZh ? "搜索" : "Search";
---

<button class="search-button" type="button" disabled title={isZh ? "搜索功能即将上线" : "Search is coming soon"}>
  <Icon name="search" size={16} />
  <span class="search-button__label">{label}</span>
  <kbd>⌘K</kbd>
</button>

<style>
  .search-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--switch-border, var(--border-subtle));
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--switch-text, var(--text-secondary));
    font-size: var(--text-sm);
    cursor: not-allowed;
  }

  kbd {
    padding: 0 var(--space-1);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    font-size: var(--text-xs);
    line-height: 1.4;
  }
</style>
