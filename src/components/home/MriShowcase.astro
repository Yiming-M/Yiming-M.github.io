---
/**
 * 首页全屏展示区：前列腺 MRI 的三维解剖模型 + 切面（设计文档 §4，方案 C）。
 *
 * 两种显示方式：
 * - 3D：桌面浏览器（有鼠标、宽度 ≥ 768px、支持 WebGL2、没有开启“减少动态效果”）。
 *   页面加载后才动态加载 three.js 和数据（约 2 MB），渲染好第一帧后淡入，替换静态图。
 *   宽屏（宽高比 > 1.35）时模型偏右，左侧三条标注用引线连到模型上（mri-scene.js 会给本元素加 data-wide）。
 * - 静态图：手机、平板（触屏）、开启“减少动态效果”、不支持 WebGL2，或 3D 加载失败时，
 *   一直显示 public/home/mri/static.png（病灶所在层面的横断面 + 三个区域的彩色轮廓），标注变成左下角的图例。
 *
 * 背景色（--showcase-bg）和三种结构的颜色（--mri-pz / --mri-tz / --mri-lesion）定义在 tokens.css，
 * 3D 场景从这里读取；静态图里的同样颜色写在 scripts/mri/build_scene.py 里，改颜色时两处一起改。
 * 右下角是数据来源署名，PI-CAI 数据的 CC BY-NC 4.0 许可要求署名。
 * 换成别的数据时，按 AGENTS.md「更换首页 3D 数据」操作。
 */
import type { Locale } from "../../lib/site";

interface Props {
  locale: Locale;
}

const isZh = Astro.props.locale === "zh";

const callouts = [
  { key: "pz", title: isZh ? "外周带" : "Peripheral zone", detail: isZh ? "PZ · 大多数前列腺癌起源于此" : "PZ · where most prostate cancers arise" },
  { key: "tz", title: isZh ? "移行带" : "Transition zone", detail: isZh ? "TZ · 环绕尿道，随年龄增大" : "TZ · surrounds the urethra, enlarges with age" },
  { key: "lesion", title: isZh ? "病灶" : "Lesion", detail: isZh ? "临床显著性癌 · ISUP 2 级" : "Clinically significant cancer · ISUP grade 2" },
];
---

<section class="showcase" data-mri aria-label={isZh ? "研究展示：前列腺 MRI" : "Research showcase: prostate MRI"}>
  <img
    class="still"
    src="/home/mri/static.png"
    width="688"
    height="688"
    alt={isZh
      ? "前列腺 T2 加权 MRI 横断面：青绿色轮廓为外周带，淡紫色轮廓为移行带，橙色区域为一处临床显著性癌病灶"
      : "Axial T2-weighted prostate MRI: the peripheral zone outlined in teal, the transition zone in lavender, and a clinically significant cancer lesion in orange"}
    decoding="async"
    fetchpriority="high"
  />
  <canvas class="scene" aria-hidden="true"></canvas>
  <svg class="leaders" aria-hidden="true">
    {callouts.map((item) => <path data-leader={item.key} class={item.key} />)}
  </svg>

  <ol class="callouts" role="list">
    {
      callouts.map((item) => (
        <li data-callout={item.key}>
          <span class:list={["swatch", item.key]} aria-hidden="true" />
          <span class="text">
            <strong>{item.title}</strong>
            <span>{item.detail}</span>
          </span>
        </li>
      ))
    }
  </ol>

  <p class="hint" aria-hidden="true">
    {isZh ? "左右移动鼠标旋转，上下移动扫过切面" : "Move the mouse sideways to rotate, up and down to sweep the slice"}
    <span class="readout">{isZh ? "层面 " : "Slice "}<span data-readout></span></span>
  </p>

  <p class="credit">
    {isZh ? "数据：" : "Data: "}
    <a href="https://pi-cai.grand-challenge.org/">PI-CAI</a>
    {isZh ? "公开数据集，" : " public dataset, "}
    <a href="https://creativecommons.org/licenses/by-nc/4.0/">CC BY-NC 4.0</a>
  </p>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-mri]");
  const canvas = root?.querySelector<HTMLCanvasElement>("canvas.scene");

  /** 只在桌面浏览器上启用 3D（条件见文件开头的说明）。 */
  function canAnimate() {
    const fine = window.matchMedia("(pointer: fine)").matches;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const wide = window.innerWidth >= 768;
    const webgl2 = Boolean(document.createElement("canvas").getContext("webgl2"));
    return fine && !reduced && wide && webgl2;
  }

  if (root && canvas && canAnimate()) {
    const byKey = <T extends Element>(selector: string, attribute: string) =>
      Object.fromEntries([...root.querySelectorAll<T>(selector)].map((element) => [element.getAttribute(attribute)!, element]));
    import("./mri-scene.js")
      .then(({ startMriScene }) =>
        startMriScene(canvas, {
          base: "/home/mri/",
          root,
          callouts: byKey<HTMLElement>("[data-callout]", "data-callout"),
          leaders: byKey<SVGPathElement>("[data-leader]", "data-leader"),
          readout: root.querySelector<HTMLElement>("[data-readout]") ?? undefined,
          onReady: () => root.setAttribute("data-ready", ""),
        }),
      )
      .catch(() => {
        // 加载失败时保留静态图，不影响页面其他部分
      });
  }
</script>

<style>
  .showcase {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: var(--showcase-bg);
    color: var(--showcase-text-muted);
  }

  /* 静态图：居中，占画面高度的约 78%。 */
  .still {
    width: min(78svh, 94vw);
    height: auto;
    aspect-ratio: 1;
  }

  /* 3D 画布铺满展示区；第一帧渲染完成（data-ready）后淡入。
   * 就绪之前完全隐藏（visibility: hidden），不参与绘制，静态图始终可见。 */
  .scene,
  .leaders {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scene {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 700ms var(--ease),
      visibility 0s 700ms;
  }

  .showcase[data-ready] .scene {
    opacity: 1;
    visibility: visible;
    transition: opacity 700ms var(--ease);
  }

  .showcase[data-ready] .still {
    visibility: hidden;
  }

  /* —— 引线：只在 3D 且宽屏时显示 —— */
  .leaders {
    display: none;
    pointer-events: none;
    overflow: visible;
  }

  .showcase[data-ready][data-wide] .leaders {
    display: block;
  }

  .leaders path {
    fill: none;
    stroke-width: 1;
    stroke-dasharray: 3 3;
    opacity: 0.75;
  }

  .leaders .pz {
    stroke: var(--mri-pz);
  }

  .leaders .tz {
    stroke: var(--mri-tz);
  }

  .leaders .lesion {
    stroke: var(--mri-lesion);
  }

  /* —— 标注 ——
   * 默认（静态图、窄屏）：左下角的紧凑图例。3D 宽屏：左侧竖排的大号标注，引线连到模型。 */
  .callouts {
    position: absolute;
    left: var(--gutter);
    bottom: calc(var(--space-6) + 2.5rem);
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .callouts li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .callouts .text {
    display: grid;
  }

  .callouts strong {
    color: var(--showcase-text);
    font-weight: 500;
  }

  .callouts .text > span {
    display: none;
  }

  .swatch {
    flex: none;
    width: 0.7rem;
    height: 0.7rem;
    margin-top: 0.3em;
    border-radius: 3px;
  }

  .swatch.pz {
    background: var(--mri-pz);
  }

  .swatch.tz {
    background: var(--mri-tz);
  }

  .swatch.lesion {
    background: var(--mri-lesion);
  }

  .showcase[data-ready][data-wide] .callouts {
    top: 50%;
    bottom: auto;
    left: clamp(var(--gutter), 6vw, 7rem);
    gap: var(--space-8);
    max-width: 18rem;
    font-size: var(--text-sm);
    transform: translateY(-50%);
  }

  .showcase[data-ready][data-wide] .callouts strong {
    font-size: var(--text-lg);
  }

  .showcase[data-ready][data-wide] .callouts .text > span {
    display: block;
  }

  /* —— 操作提示和当前层面：只在 3D 时显示 —— */
  .hint {
    position: absolute;
    left: 50%;
    bottom: var(--space-6);
    display: none;
    gap: var(--space-3);
    font-size: var(--text-xs);
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .showcase[data-ready] .hint {
    display: flex;
  }

  .readout {
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }

  .credit {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-6);
    max-width: 40%;
    font-size: var(--text-xs);
    line-height: 1.6;
    text-align: right;
  }

  .credit a {
    color: inherit;
  }

  .credit a:hover {
    color: var(--showcase-text);
  }

  /* 3D 但不够宽时（如 768–1000px），操作提示放到署名上方，避免与图例、署名挤在一行。 */
  @media (max-width: 1099.98px) {
    .hint {
      left: auto;
      right: var(--gutter);
      bottom: calc(var(--space-6) + 1.8rem);
      transform: none;
    }
  }

  /* 窄屏：图例和署名上下排列。 */
  @media (max-width: 599.98px) {
    .credit {
      left: var(--gutter);
      max-width: none;
      text-align: left;
    }
  }
</style>
