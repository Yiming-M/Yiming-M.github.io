---
/**
 * 站内用到的小图标（内联 SVG，线条颜色跟随文字颜色 currentColor）。
 *
 * 用法：<Icon name="search" />
 * 图标默认对屏幕阅读器隐藏（aria-hidden），按钮的可读名称由按钮自己的文字或 aria-label 提供。
 * 新增图标：在 paths 里加一项，使用 24×24 的画布、1.75 的线宽，与现有图标保持一致。
 */
interface Props {
  name: "search" | "sun" | "moon" | "auto" | "menu";
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "search" && (
    <>
      <circle cx="11" cy="11" r="6.5" />
      <path d="M16 16l4.5 4.5" />
    </>
  )}
  {name === "sun" && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" />
    </>
  )}
  {name === "moon" && <path d="M19.5 14.2A7.5 7.5 0 1 1 9.8 4.5a6 6 0 0 0 9.7 9.7z" />}
  {name === "auto" && (
    <>
      <circle cx="12" cy="12" r="8" />
      <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none" />
    </>
  )}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
</svg>

<style>
  .icon {
    flex: none;
  }
</style>
