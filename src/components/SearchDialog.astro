---
/**
 * 站内搜索对话框（设计文档 §7.7），基于 Pagefind。
 *
 * 工作方式：
 * - `npm run build` 在 Astro 构建完成后运行 `pagefind --site dist`，为页面里标了 data-pagefind-body 的区域
 *   （文章正文、论文详情、About Me）建立索引，生成 dist/pagefind/。中英文页面按 <html lang> 分别建索引，
 *   搜索时自动只查当前语言。
 * - 第一次打开对话框时才加载 /pagefind/pagefind-ui.js 和 .css，不影响页面首次加载。
 * - 本地开发服务器（npm run dev）没有索引，打开时会显示说明文字。
 *
 * 打开方式：点击页头的搜索按钮（data-search-open），或按 ⌘K / Ctrl+K。按 Esc 或点击对话框外关闭。
 */
import type { Locale } from "../lib/site";

interface Props {
  locale: Locale;
}

const isZh = Astro.props.locale === "zh";
---

<dialog class="search-dialog" data-search-dialog aria-label={isZh ? "搜索" : "Search"}>
  <div class="panel">
    <div data-search-root></div>
    <p class="unavailable" data-search-unavailable hidden>
      {isZh ? "搜索索引在构建后才会生成（npm run build），本地开发服务器里暂时不能搜索。" : "The search index is generated at build time (npm run build), so search is unavailable on the dev server."}
    </p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");

  if (dialog) {
    let loaded: Promise<void> | null = null;

    /** 加载 Pagefind 的界面脚本和样式，并在对话框里初始化搜索框。只执行一次。 */
    const loadSearch = () => {
      loaded ??= new Promise<void>((resolve, reject) => {
        const css = document.createElement("link");
        css.rel = "stylesheet";
        css.href = "/pagefind/pagefind-ui.css";
        document.head.append(css);
        const script = document.createElement("script");
        script.src = "/pagefind/pagefind-ui.js";
        script.onload = () => resolve();
        script.onerror = () => reject();
        document.head.append(script);
      })
        .then(() => {
          // @ts-expect-error PagefindUI 由上面加载的脚本挂到 window 上
          new window.PagefindUI({ element: "[data-search-root]", showSubResults: true, showImages: false, resetStyles: false });
        })
        .catch(() => {
          dialog.querySelector<HTMLElement>("[data-search-unavailable]")!.hidden = false;
        });
      return loaded;
    };

    const open = async () => {
      if (!dialog.open) dialog.showModal();
      await loadSearch();
      dialog.querySelector<HTMLInputElement>("input")?.focus();
    };

    document.querySelectorAll("[data-search-open]").forEach((button) => button.addEventListener("click", open));

    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        open();
      }
    });

    // 点击对话框外面的半透明背景时关闭
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .search-dialog {
    width: min(40rem, calc(100vw - 2 * var(--gutter)));
    max-height: min(80vh, 44rem);
    margin: 10vh auto auto;
    padding: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-surface);
    background: var(--surface);
    color: var(--text-primary);
    box-shadow: var(--shadow-float);
  }

  .search-dialog::backdrop {
    background: rgb(17 19 24 / 40%);
    backdrop-filter: blur(2px);
  }

  .panel {
    padding: var(--space-4);
    /* Pagefind 界面的配色和字体，对应 tokens.css 的语义变量。 */
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--accent);
    --pagefind-ui-text: var(--text-primary);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border-subtle);
    --pagefind-ui-tag: var(--surface-subtle);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-font: var(--font-text);
  }

  .unavailable {
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }
</style>
