---
import "../styles/global.css";
import { localePath, site, type Locale } from "../lib/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  image?: string;
  imageAlt?: string;
}

const {
  locale,
  title,
  description,
  path = "/",
  type = "website",
  publishedTime,
  image,
  imageAlt,
} = Astro.props;

const isZh = locale === "zh";
const canonical = new URL(localePath(locale, path), Astro.site);
const alternate = new URL(localePath(isZh ? "en" : "zh", path), Astro.site);
const socialImage = image ? new URL(image, Astro.site) : undefined;
const nav = [
  { path: "/publications", en: "Research", zh: "研究" },
  { path: "/writing", en: "Posts", zh: "随笔" },
  { path: "/topics", en: "Topics", zh: "主题" },
  { path: "/about", en: "About", zh: "关于" },
];
const normalizedPath = path === "/" ? "/" : `/${path.replace(/^\/+|\/+$/g, "")}`;
const isCurrentNav = (navPath: string) => normalizedPath === navPath || normalizedPath.startsWith(`${navPath}/`);
const themeChoices = [
  { value: "auto", en: "Auto", zh: "自动" },
  { value: "light", en: "Light", zh: "亮色" },
  { value: "dark", en: "Dark", zh: "暗色" },
];
const personData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  alternateName: site.nameZh,
  honorificPrefix: "Dr.",
  description: "Researcher in multimodal learning for medical imaging AI and computer vision.",
  url: new URL(localePath(locale), Astro.site).href,
  sameAs: [site.scholar, site.github, site.linkedin],
  knowsAbout: ["Multimodal learning", "Medical imaging AI", "Computer vision", "Vision-language learning"],
};
const websiteData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.displayName,
  alternateName: [site.name, site.displayNameZh, "YM Research Notebook"],
  url: new URL(localePath("en"), Astro.site).href,
};
---

<!doctype html>
<html lang={isZh ? "zh-CN" : "en"} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f4ee" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={isZh ? "en" : "zh-CN"} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={new URL(localePath("en", path), Astro.site)} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.displayName} />
    <meta property="og:locale" content={isZh ? "zh_CN" : "en_GB"} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <title>{title}</title>
    {!isZh && normalizedPath === "/" && (
      <script is:inline>
        (() => {
          const storedLocale = localStorage.getItem("site-locale");
          const localePreference = storedLocale === "en" || storedLocale === "zh" ? storedLocale : null;
          const primaryLanguage = navigator.languages?.[0] || navigator.language || "en";
          const defaultLocale = primaryLanguage.toLowerCase().startsWith("zh") ? "zh" : "en";
          if ((localePreference || defaultLocale) === "zh") window.location.replace("/zh/");
        })();
      </script>
    )}
    <script is:inline>
      (() => {
        const storedPreference = localStorage.getItem("site-theme");
        const preference = storedPreference === "light" || storedPreference === "dark" || storedPreference === "auto" ? storedPreference : "auto";
        if (storedPreference !== preference) localStorage.setItem("site-theme", preference);
        const dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = preference === "auto" ? (dark ? "dark" : "light") : preference;
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personData)} />
    {!isZh && normalizedPath === "/" && <script type="application/ld+json" set:html={JSON.stringify(websiteData)} />}
  </head>
  <body>
    <a class="skip-link" href="#content">{isZh ? "跳到正文" : "Skip to content"}</a>
    <div class="site-shell">
      <header class="site-header" aria-label={isZh ? "主导航" : "Primary navigation"}>
        <div class="mobile-header-row">
          <a class="brand" href={localePath(locale)} aria-label={isZh ? "一铭の研究手记首页" : "Yiming's Research Notebook homepage"}>
            <span class="brand-mark">YM</span>
            <span class="brand-copy">
              <strong>{isZh ? "一铭の" : "Yiming's"}</strong>
              <small>{isZh ? "研究手记" : "Research notebook"}</small>
            </span>
          </a>

          <details class="mobile-menu">
            <summary>
              <span>{isZh ? "菜单" : "Menu"}</span>
              <span class="mobile-menu-icon" aria-hidden="true"></span>
            </summary>
            <div class="mobile-menu-panel">
              <nav aria-label={isZh ? "移动页面导航" : "Mobile sections"}>
                {nav.map((item) => (
                  <a href={localePath(locale, item.path)} aria-current={isCurrentNav(item.path) ? "page" : undefined}>
                    <span>{isZh ? item.zh : item.en}</span>
                    {isCurrentNav(item.path) && <small>{isZh ? "当前" : "Current"}</small>}
                  </a>
                ))}
              </nav>
              <div class="mobile-menu-preferences">
                <div class="mobile-language-group">
                  <p>{isZh ? "语言" : "Language"}</p>
                  <div class="segmented mobile-language-control" role="group" aria-label={isZh ? "语言" : "Language"}>
                    <a href={localePath("en", path)} data-locale-choice="en" aria-current={!isZh ? "page" : undefined}>EN</a>
                    <a href={localePath("zh", path)} data-locale-choice="zh" aria-current={isZh ? "page" : undefined}>中文</a>
                  </div>
                </div>
                <div class="mobile-theme-group">
                  <p>{isZh ? "显示主题" : "Display theme"}</p>
                  <div class="mobile-theme-options" role="group" aria-label={isZh ? "主题" : "Theme"}>
                    {themeChoices.map((choice) => (
                      <button
                        type="button"
                        data-theme-choice={choice.value}
                        aria-pressed={choice.value === "auto" ? "true" : "false"}
                        title={isZh ? choice.zh : choice.en}
                      >
                        {isZh ? choice.zh : choice.en}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </details>
        </div>

        <nav class="main-nav" aria-label={isZh ? "页面" : "Sections"}>
          {nav.map((item) => (
            <a href={localePath(locale, item.path)} aria-current={isCurrentNav(item.path) ? "page" : undefined}>
              {isZh ? item.zh : item.en}
            </a>
          ))}
        </nav>

        <div class="header-controls">
          <div class="segmented language-control" role="group" aria-label={isZh ? "语言" : "Language"}>
            <a href={localePath("en", path)} data-locale-choice="en" aria-current={!isZh ? "page" : undefined}>EN</a>
            <a href={localePath("zh", path)} data-locale-choice="zh" aria-current={isZh ? "page" : undefined}>中文</a>
          </div>
          <div class="segmented theme-control" role="group" aria-label={isZh ? "主题" : "Theme"}>
            {themeChoices.map((choice) => (
              <button
                type="button"
                data-theme-choice={choice.value}
                aria-pressed={choice.value === "auto" ? "true" : "false"}
                title={isZh ? choice.zh : choice.en}
              >
                {isZh ? choice.zh : choice.en}
              </button>
            ))}
          </div>
        </div>
      </header>

      <main id="content" tabindex="-1">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-primary">
          <div class="footer-brand">
            <strong>{site.name} · {site.nameZh}</strong>
            <p>{isZh ? "多模态学习、医学影像 AI 与计算机视觉研究手记。" : "Research notes on multimodal learning, medical imaging AI, and computer vision."}</p>
          </div>
          <nav class="footer-nav" aria-label={isZh ? "页脚页面导航" : "Footer sections"}>
            {nav.map((item) => (
              <a href={localePath(locale, item.path)} aria-current={isCurrentNav(item.path) ? "page" : undefined}>
                {isZh ? item.zh : item.en}
              </a>
            ))}
          </nav>
        </div>
        <div class="footer-secondary">
          <div class="footer-links">
            <a href={site.scholar}><span>Scholar</span><span aria-hidden="true"> ↗</span></a>
            <a href={site.github}><span>GitHub</span><span aria-hidden="true"> ↗</span></a>
            <a href={site.linkedin}><span>LinkedIn</span><span aria-hidden="true"> ↗</span></a>
            <a href={`mailto:${site.email}`}><span>{isZh ? "邮件" : "Email"}</span><span aria-hidden="true"> ↗</span></a>
          </div>
          <p>© {new Date().getUTCFullYear()} {site.name}</p>
          <a class="back-to-top" href="#content"><span>{isZh ? "返回顶部" : "Back to top"}</span><span aria-hidden="true"> ↑</span></a>
        </div>
      </footer>
    </div>

    <script is:inline>
      const media = window.matchMedia("(prefers-color-scheme: dark)");
      const storedPreference = localStorage.getItem("site-theme");
      let preference = storedPreference === "light" || storedPreference === "dark" || storedPreference === "auto" ? storedPreference : "auto";
      if (storedPreference !== preference) localStorage.setItem("site-theme", preference);
      const controls = document.querySelectorAll("[data-theme-choice]");
      const applyTheme = () => {
        const theme = preference === "auto" ? (media.matches ? "dark" : "light") : preference;
        document.documentElement.dataset.theme = theme;
        const themeMeta = document.querySelector('meta[name="theme-color"]');
        if (themeMeta) themeMeta.content = theme === "dark" ? "#111318" : "#f6f4ee";
        controls.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.themeChoice === preference)));
      };
      controls.forEach((button) => button.addEventListener("click", () => {
        preference = button.dataset.themeChoice;
        localStorage.setItem("site-theme", preference);
        applyTheme();
      }));
      media.addEventListener("change", () => preference === "auto" && applyTheme());
      applyTheme();

      document.querySelectorAll("[data-locale-choice]").forEach((link) => {
        link.addEventListener("click", () => {
          const choice = link.dataset.localeChoice;
          if (choice === "en" || choice === "zh") localStorage.setItem("site-locale", choice);
        });
      });

      const mobileMenu = document.querySelector(".mobile-menu");
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && mobileMenu?.open) {
          mobileMenu.open = false;
          mobileMenu.querySelector("summary")?.focus();
        }
      });
    </script>
  </body>
</html>
